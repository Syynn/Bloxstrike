            else W.status="unknown: ray result outside requested segment" end
        else W.status="unknown: unreadable ray hit fields" end
    end
    if clear then W.clear=W.clear+1 elseif W.status:sub(1,7)=="blocked" then W.blocked=W.blocked+1 else W.unknown=W.unknown+1 end
