end

-- Read only when the user requests a report. Stored coordinates are diagnostic
-- observations, never admitted to the rendering/aim cache as live positions.
function C.RangeAudit()
    local counts={opponents=0,live=0,stored=0,other=0,missing=0,hidden=0,unknown=0}
    local rows={"-- ROSTER RANGE SNAPSHOT (players only; requested with report) --",
        "One non-atomic snapshot, not continuous evidence. Stored/cull coordinates can be stale. Bots without Player references are outside this roster audit."}
    local ok,players=pcall(function() return roster:GetPlayers() end)
    if not ok or type(players)~="table" then players=rosterList or {}; rows[#rows+1]="GetPlayers unavailable; using cached roster" end
    local localTeam=readLocalTeam(player)
    local cam=get(world,"CurrentCamera"); local camPosition=xyz(get(cam,"Position"))
    for i=1,math.min(#players,cfg.MaxPlayers) do
        local p=players[i]
        if not same(p,player) then
            local team=readLocalTeam(p)
            local opponent=localTeam~=nil and team~=nil and localTeam~=team
            local char=get(p,"Character"); local hp=attribute(p,"Health"); local dead=attribute(p,"Dead")
            local presentation=attribute(char,"ClientCharacterPresentationVisible")
            local location="no Character"; local parent=get(char,"Parent")
            local name=get(parent,"Name")
            if char then
                if liveParent(char) then location="live Characters"
                elseif name=="_PVS_CulledCharacters" then location="stored/cull"
                else location="other container" end
            end
            if opponent and finite(hp) and hp>0 and dead==false then
                counts.opponents=counts.opponents+1
                if location=="live Characters" then
                    counts.live=counts.live+1
                    if presentation~=true then counts.hidden=counts.hidden+1 end
                elseif location=="stored/cull" then counts.stored=counts.stored+1
                elseif location=="no Character" then counts.missing=counts.missing+1
                else counts.other=counts.other+1 end
            elseif not team then counts.unknown=counts.unknown+1 end
            local position,screen
            if char then
                local part
                local found,value=pcall(function() return char:FindFirstChild("Head") end)
                if found then part=value end
                if part and same(get(part,"Parent"),char) then position=xyz(get(part,"Position")) end
                if position then
                    local good,_,visible=pcall(function() return WorldToScreen(Vector3.new(position[1],position[2],position[3])) end)
                    if good and type(visible)=="boolean" then screen=visible end
                end
            end
            local distance=position and camPosition and math.sqrt((position[1]-camPosition[1])^2+(position[2]-camPosition[2])^2+(position[3]-camPosition[3])^2)
            local path="nil"
            if char then
                local good,value=pcall(function() return char:GetFullName() end)
                path=good and str(value,240) or str(get(char,"Name"))
            end
            local e=char and entryMap[id(char)]
            local reason=e and (e.blocked or e.state or "pending geometry") or (location=="stored/cull" and "excluded: stored position not verified live" or "not in current cache")
            rows[#rows+1]=str(get(p,"Name"),80).." relation="..(opponent and "opponent" or (team and "teammate/unknown local team" or "unknown team"))..
                " team="..str(team).." health="..str(hp).." dead="..str(dead).." location="..location.." presentation="..str(presentation)..
                " observedHeadDistance="..(distance and string.format("%.1f",distance) or "unavailable").." projectedOnScreen="..str(screen).." reason="..reason.." path="..path
        end
    end
    table.insert(rows,2,string.format("Alive player opponents=%d live=%d stored/cull=%d other=%d missingCharacter=%d liveWithHiddenOrUnknownPresentation=%d unknownTeamPlayers=%d",counts.opponents,counts.live,counts.stored,counts.other,counts.missing,counts.hidden,counts.unknown))
    C.LastRangeAudit=counts
    return rows
end

