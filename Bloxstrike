    local data=R.data; local name=data.Name; local rounds=data.Rounds
    if type(name)~="string" or not finite(rounds) or rounds<0 or rounds~=math.floor(rounds) then return block("equipped weapon / rounds unresolved") end
    if name~=P.Current then return block("weapon profile changing") end
    if not cfg.RCSProfileAllowed then return block("RCS disabled for weapon profile") end
    if type(data.Identifier)~="string" or #data.Identifier==0 then return block("weapon item identity unresolved") end
    local identifier=data.Identifier
    local team=readLocalTeam(player)
    local previous=R.prev
