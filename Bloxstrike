        if instance and type(className)=="string" and pos then
            local hx,hy,hz=pos[1]-origin[1],pos[2]-origin[2],pos[3]-origin[3]
            local along=(hx*dx+hy*dy+hz*dz)/length
            local px,py,pz=hx-dx*along/length,hy-dy*along/length,hz-dz*along/length
            if along>=-.05 and along<=length+.25 and px*px+py*py+pz*pz<=.25 then
                W.validHit=true
