    local ok,hit=pcall(function() return world:Raycast(Vector3.new(origin[1],origin[2],origin[3]),Vector3.new(dx,dy,dz)) end)
    local cost=clock()-before;W.total=W.total+cost;W.max=math.max(W.max,cost)
