local function newDrawing(kind,color)
    local obj=Drawing.new(kind); drawings[#drawings+1]=obj
    assign(obj,"Visible",false)
    assign(obj,"Color",color)
    if kind=="Square" then assign(obj,"Filled",false)
    elseif kind=="Line" then assign(obj,"Thickness",1)
    elseif kind=="Circle" then
        assign(obj,"Radius",cfg.HeadDotRadius)
        pcall(function() obj.Filled=true end)
        pcall(function() obj.NumSides=12 end)
    elseif kind=="Text" then
        local ok=pcall(function() obj.Size=14 end)
        C.TextSizeAccepted=ok
        pcall(function() obj.Outline=true end)
    end
    return obj
end
local function tryDrawing(kind,color)
    local ok,result=pcall(newDrawing,kind,color)
