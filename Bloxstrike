local function modelState(e)
    local model,owner=e.model,e.owner
    local mt=teamName(attribute(model,"Team")); local pt=owner and readLocalTeam(owner)
    e.team=pt or mt
    e.health=attribute(model,"Health"); e.dead=attribute(model,"Dead")
    local ph=owner and attribute(owner,"Health"); local pd=owner and attribute(owner,"Dead")
    e.presentation=attribute(model,"ClientCharacterPresentationVisible")
    e.bot=attribute(model,"Bot")==true; e.teamEvidence=owner and "Player/character attributes" or "Bot character attributes"
    if not liveParent(model) then return "outside live character folder" end
    if same(model,localCharacter) then return "local character" end
    if not owner and not e.bot then return "ownership unconfirmed; not a confirmed bot" end
    if owner and not same(get(owner,"Character"),model) then return "owner character reference changed" end
    if pt and mt and pt~=mt then e.team=nil; return "conflicting team attributes" end
    if not e.team then return "team unavailable" end
    if e.dead==true or pd==true then return "dead" end
    if (finite(e.health) and e.health<=0) or (finite(ph) and ph<=0) then return "zero health" end
    if not ((finite(e.health) and e.health>0 and e.dead==false) or (finite(ph) and ph>0 and pd==false)) then return "alive state unconfirmed" end
    if e.presentation~=true then return "presentation hidden or unavailable" end
