local function aimCandidate(e,vw,vh,radius,acquiring)
    if not C.LocalTeam then return nil,"local team unavailable" end
    if not e.team then return nil,"unknown/conflicting team" end
    if e.team==C.LocalTeam then return nil,"teammate team" end
    if e.state~="rendered" or not e.lastBox then return nil,"no current on-screen body: "..str(e.state,90) end
    if not finite(e.distance) then return nil,"body distance unavailable" end
    if cfg.AimMaxDistance>0 and e.distance>cfg.AimMaxDistance then return nil,"beyond aim distance limit" end
    local upper=e.framePositions and e.framePositions.uppertorso
    local lower=e.framePositions and e.framePositions.lowertorso
    local head=e.framePositions and e.framePositions.head
    -- Refresh only the requested aim anchors from this existing rig cache.
    -- This avoids waiting behind the geometry reads for every other visible body.
    for _,part in ipairs(e.parts) do
        if cfg.AimPoint=="Head" and part.name=="head" then head=readBodyPosition(e,part)
        elseif cfg.AimPoint~="Head" and part.name=="uppertorso" then upper=readBodyPosition(e,part)
        elseif cfg.AimPoint=="Torso" and part.name=="lowertorso" then lower=readBodyPosition(e,part) end
    end
    e.positionReadAt=clock()
    local p,source
    if cfg.AimPoint=="Head" then p=head; source="Head center"
    elseif cfg.AimPoint=="Chest" then p=upper; source="UpperTorso center"
    else p=upper or lower; source="Torso center mass" end
    if not p then return nil,"selected "..cfg.AimPoint.." position unavailable" end
    local x,y,z=p[1],p[2],p[3]
    if cfg.AimPoint=="Torso" and upper and lower then x=(upper[1]+lower[1])/2; y=(upper[2]+lower[2])/2; z=(upper[3]+lower[3])/2 end
    local anchor=e.framePositions[e.anchorName]
    if not anchor or math.max(math.abs(x-anchor[1]),math.abs(y-anchor[2]),math.abs(z-anchor[3]))>cfg.MaxBodySpan then return nil,"selected point outside compact body" end
    local sx,sy=project(x,y,z)
    if not sx or sx<0 or sy<0 or sx>vw or sy>vh then return nil,"selected aim point projects offscreen" end
    local dx,dy=sx-vw/2,sy-vh/2
    local distance=math.sqrt(dx*dx+dy*dy)
    local bodyAssisted=false
    if distance>radius and acquiring and cfg.AimBodyAcquire and distance<=cfg.AimTrackRadius then
        local box=e.lastBox
        local bx=clamp(vw/2,box[1],box[3])-vw/2
        local by=clamp(vh/2,box[2],box[4])-vh/2
        bodyAssisted=bx*bx+by*by<=radius*radius
    end
    if distance>radius and not bodyAssisted then return nil,string.format("outside circle: %.1fpx > %.1fpx",distance,radius),distance,"outside acquisition/tracking radius" end
    return {entry=e,x=sx,y=sy,dx=dx,dy=dy,error=distance,source=source,world={x,y,z},sampleAt=e.positionReadAt,bodyAssisted=bodyAssisted}
end
-- Estimate target movement by projecting both world positions through the current camera.
-- Raw screen deltas would incorrectly include this client's own camera correction.
function A.response(target,now,dt)
    local prior=A.motion
    local nextSample={key=target.entry.key,source=target.source,camera=id(camera),point=target.world,time=target.sampleAt or now,vx=0,vy=0}
    local valid=false
    if prior and prior.key==nextSample.key and prior.source==nextSample.source and prior.camera==nextSample.camera and dt>0 and dt<=.08 then
        local elapsed=nextSample.time-prior.time
        local p,q=prior.point,target.world
        local distance=math.sqrt((q[1]-p[1])^2+(q[2]-p[2])^2+(q[3]-p[3])^2)
        if elapsed>=.001 and elapsed<=.08 and distance/elapsed<=120 then
            local px,py=project(p[1],p[2],p[3])
            if px then
                local vx,vy=(target.x-px)/elapsed,(target.y-py)/elapsed
                if finite(vx) and finite(vy) and vx*vx+vy*vy<=3000^2 then
                    local weight=1-math.exp(-elapsed/.025)
                    -- Stop/reversal observations take effect immediately, without an old-direction tail.
                    if vx*prior.vx+vy*prior.vy<=0 or vx*vx+vy*vy<1 then weight=1 end
                    nextSample.vx=prior.vx+(vx-prior.vx)*weight
                    nextSample.vy=prior.vy+(vy-prior.vy)*weight
                    valid=true
                end
            end
        end
    end
    if prior and not valid then A.motionResets=A.motionResets+1 end
    A.motion=nextSample
    local lx,ly=nextSample.vx*cfg.AimMotionLead,nextSample.vy*cfg.AimMotionLead
    local length=math.sqrt(lx*lx+ly*ly)
    local cap=math.min(24,cfg.AimTrackRadius*.25)
    if length>cap then lx=lx*cap/length;ly=ly*cap/length;A.motionClamps=A.motionClamps+1 end
    local boost=1
    if A.acquiredAt and now-A.acquiredAt>=0 and now-A.acquiredAt<.08 then
        boost=1+(cfg.AimAcquireBoost-1)*(1-(now-A.acquiredAt)/.08)
        if boost>1 then A.boostFrames=A.boostFrames+1 end
    end
    A.leadX=lx;A.leadY=ly;A.maxLead=math.max(A.maxLead,math.sqrt(lx*lx+ly*ly))
    if math.abs(lx)+math.abs(ly)>.01 then A.motionFrames=A.motionFrames+1 end
    local age=math.max(0,now-(target.sampleAt or now))
    A.sampleAgeCount=A.sampleAgeCount+1;A.sampleAgeTotal=A.sampleAgeTotal+age;A.sampleAgeMax=math.max(A.sampleAgeMax,age)
    return (target.dx+lx)*boost,(target.dy+ly)*boost
end
