        R.gates[R.gate]=(R.gates[R.gate] or 0)+1;return
    end
    if previous and rounds<previous.rounds then
        local drop=previous.rounds-rounds
        local age=previous.at and clock()-previous.at or dt
        if drop<=4 and age>0 and age<=.16 then
            R.debtX=R.debtX-cfg.RCSHorizontal/cfg.RCSYawPerUnit*drop
