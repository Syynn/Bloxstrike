    local n=math.sqrt(x*x+y*y)
    if n>8 then x=whole(x*8/n);y=whole(y*8/n);R.stepClamps=R.stepClamps+1 end
    R.requestX=x;R.requestY=y
    R.gate=(x~=0 or y~=0) and "sustained shot correction" or "armed: observing ammo"
