            if now>=e.nextTeam then
                e.blocked=modelState(e); e.nextTeam=now+cfg.TeamInterval; stats.teamRefreshes=stats.teamRefreshes+1
            elseif e.owner and not same(get(e.owner,"Character"),model) then e.blocked="owner character reference changed" end
            if not e.blocked and now>=e.nextParts then
