    world=game:GetService("Workspace"); assert(world,"Workspace unavailable")
    if not root or not same(get(root,"Parent"),world) or get(root,"Name")~="Characters" then
        local nextRoot
        for _,obj in ipairs(children(world) or {}) do if get(obj,"Name")=="Characters" then nextRoot=obj; break end end
        root=nextRoot; entryMap={}; hideAll()
    end
    roster=roster or game:GetService("Players"); player=get(roster,"LocalPlayer")
    localCharacter=get(player,"Character")
    if now>=nextLocalState then
        nextLocalState=now+cfg.LocalStateInterval; C.LocalAimBlock=nil
        local health=attribute(player,"Health"); local dead=attribute(player,"Dead"); local spectating=attribute(player,"IsSpectating")
        if not localCharacter or not liveParent(localCharacter) then C.LocalAimBlock="local character not live"
        elseif spectating==true then C.LocalAimBlock="local spectator"
        elseif dead~=false or not finite(health) or health<=0 then C.LocalAimBlock="local alive state unconfirmed/dead" end
        local nextTeam=readLocalTeam(player)
        if nextTeam~=C.LocalTeam then C.LocalTeam=nextTeam; ui.dirty=true; resetAim("local team changed"); hideAll() end
    end
    if now>=nextRoster then
        nextRoster=now+cfg.RosterInterval
        local ok,list=pcall(function() return roster:GetPlayers() end)
        if not ok or type(list)~="table" then
            list={}; for _,obj in ipairs(children(roster) or {}) do if get(obj,"ClassName")=="Player" then list[#list+1]=obj end end
        end
        rosterList={}
        for i=1,math.min(#list,cfg.MaxPlayers) do rosterList[#rosterList+1]=list[i] end
    end
    -- Refresh current Character references cheaply; never match player ownership by name.
    ownerMap={}
    for _,p in ipairs(rosterList) do local char=get(p,"Character"); if char then ownerMap[id(char)]=p end end
    local models={}
    for _,obj in ipairs(children(root) or {}) do
        local name=get(obj,"Name"); local class=get(obj,"ClassName")
        if containers[name] then
            for _,child in ipairs(children(obj) or {}) do
                if #models>=cfg.MaxDiscoveryModels then break end
