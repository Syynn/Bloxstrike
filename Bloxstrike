end

-- Input selection uses fresh cached body parts, independently of ESP boxes.
function A.freshCandidate(e,vw,vh,radius,acquiring)
    if e.presentation~=true then return nil,"presentation hidden: visual-only body" end
    if e.blocked then return nil,e.blocked end
    if not C.LocalTeam or not e.team then return nil,"local/target team unavailable" end
    if e.team==C.LocalTeam then return nil,"teammate team" end
    if not liveParent(e.model) or (e.owner and not same(get(e.owner,"Character"),e.model)) then return nil,"no current live body" end
    local selected,upper,lower
    for _,part in ipairs(e.parts or {}) do
        if part.name=="uppertorso" then upper=part end
        if part.name=="lowertorso" then lower=part end
        if cfg.AimPoint=="Head" and part.name=="head" then selected=part end
    end
    if cfg.AimPoint=="Chest" then selected=upper elseif cfg.AimPoint=="Torso" then selected=upper or lower end
    if not selected then return nil,"selected aim part unavailable / cache warming" end
    local p=readBodyPosition(e,selected)
    local sampleAt=clock()
    local anchor=p
    if selected~=upper and upper then anchor=readBodyPosition(e,upper) end
    if not p or not anchor then return nil,"selected aim anchor unavailable" end
    local source=cfg.AimPoint=="Head" and "Head center" or (cfg.AimPoint=="Chest" and "UpperTorso center" or "Torso center mass")
    if cfg.AimPoint=="Torso" and upper and lower then
        local q=selected==lower and p or readBodyPosition(e,lower)
        if q then p={(p[1]+q[1])/2,(p[2]+q[2])/2,(p[3]+q[3])/2} end
    end
    if math.max(math.abs(p[1]-anchor[1]),math.abs(p[2]-anchor[2]),math.abs(p[3]-anchor[3]))>cfg.MaxBodySpan then return nil,"selected point outside compact body" end
    local origin=C.AimCameraOrigin or xyz(get(camera,"Position"))
    if not origin then return nil,"camera position unavailable" end
    local worldDistance=math.sqrt((p[1]-origin[1])^2+(p[2]-origin[2])^2+(p[3]-origin[3])^2)
    if cfg.AimMaxDistance>0 and worldDistance>cfg.AimMaxDistance then return nil,"beyond aim distance limit" end
    local sx,sy=project(p[1],p[2],p[3]);if not sx then return nil,"selected aim point projects offscreen" end
    local dx,dy=sx-vw/2,sy-vh/2;local distance=math.sqrt(dx*dx+dy*dy)
    local assisted=false
    if distance>radius and acquiring and cfg.AimBodyAcquire and distance<=cfg.AimTrackRadius and e.lastBox then
        local b=e.lastBox;local bx=clamp(vw/2,b[1],b[3])-vw/2;local by=clamp(vh/2,b[2],b[4])-vh/2
        assisted=bx*bx+by*by<=radius*radius
    end
    if distance>radius and not assisted then return nil,"outside acquisition/tracking radius",distance,"outside acquisition/tracking radius" end
    if not W.check(e,p,false) then return nil,"wall check: "..W.status end
    A.freshSamples=(A.freshSamples or 0)+1
    return {entry=e,x=sx,y=sy,dx=dx,dy=dy,error=distance,source=source,world=p,sampleAt=sampleAt,bodyAssisted=assisted}
end

local function aimCandidate(e,vw,vh,radius,acquiring)
    if cfg.AimInputFirst then return A.freshCandidate(e,vw,vh,radius,acquiring) end
    if e.presentation~=true then return nil,"presentation hidden: visual-only body" end
    if not C.LocalTeam then return nil,"local team unavailable" end
    if not e.team then return nil,"unknown/conflicting team" end
    if e.team==C.LocalTeam then return nil,"teammate team" end
    if e.state~="rendered" or not e.lastBox then return nil,"no current on-screen body: "..str(e.state,90) end
    if not finite(e.distance) then return nil,"body distance unavailable" end
    if cfg.AimMaxDistance>0 and e.distance>cfg.AimMaxDistance then return nil,"beyond aim distance limit" end
    local upper=e.framePositions and e.framePositions.uppertorso
    local lower=e.framePositions and e.framePositions.lowertorso
    local head=e.framePositions and e.framePositions.head
    -- Refresh only the requested aim anchors from this existing rig cache.
    -- This avoids waiting behind the geometry reads for every other visible body.
    for _,part in ipairs(e.parts) do
        if cfg.AimPoint=="Head" and part.name=="head" then head=readBodyPosition(e,part)
        elseif cfg.AimPoint~="Head" and part.name=="uppertorso" then upper=readBodyPosition(e,part)
        elseif cfg.AimPoint=="Torso" and part.name=="lowertorso" then lower=readBodyPosition(e,part) end
    end
    e.positionReadAt=clock()
    local p,source
    if cfg.AimPoint=="Head" then p=head; source="Head center"
    elseif cfg.AimPoint=="Chest" then p=upper; source="UpperTorso center"
    else p=upper or lower; source="Torso center mass" end
    if not p then return nil,"selected "..cfg.AimPoint.." position unavailable" end
    local x,y,z=p[1],p[2],p[3]
    if cfg.AimPoint=="Torso" and upper and lower then x=(upper[1]+lower[1])/2; y=(upper[2]+lower[2])/2; z=(upper[3]+lower[3])/2 end
    if not W.check(e,{x,y,z},false) then return nil,"wall check: "..W.status end
    local anchor=e.framePositions[e.anchorName]
    if not anchor or math.max(math.abs(x-anchor[1]),math.abs(y-anchor[2]),math.abs(z-anchor[3]))>cfg.MaxBodySpan then return nil,"selected point outside compact body" end
    local sx,sy=project(x,y,z)
    if not sx or sx<0 or sy<0 or sx>vw or sy>vh then return nil,"selected aim point projects offscreen" end
    local dx,dy=sx-vw/2,sy-vh/2
    local distance=math.sqrt(dx*dx+dy*dy)
    local bodyAssisted=false
    if distance>radius and acquiring and cfg.AimBodyAcquire and distance<=cfg.AimTrackRadius then
        local box=e.lastBox
        local bx=clamp(vw/2,box[1],box[3])-vw/2
        local by=clamp(vh/2,box[2],box[4])-vh/2
        bodyAssisted=bx*bx+by*by<=radius*radius
    end
    if distance>radius and not bodyAssisted then return nil,string.format("outside circle: %.1fpx > %.1fpx",distance,radius),distance,"outside acquisition/tracking radius" end
    return {entry=e,x=sx,y=sy,dx=dx,dy=dy,error=distance,source=source,world={x,y,z},sampleAt=e.positionReadAt,bodyAssisted=bodyAssisted}
end
-- Estimate target movement by projecting both world positions through the current camera.
-- Raw screen deltas would incorrectly include this client's own camera correction.
function A.response(target,now,dt)
    local prior=A.motion
    local nextSample={key=target.entry.key,source=target.source,camera=id(camera),point=target.world,time=target.sampleAt or now,vx=0,vy=0}
    local valid=false
    if prior and prior.key==nextSample.key and prior.source==nextSample.source and prior.camera==nextSample.camera and dt>0 and dt<=(cfg.AimStableMotion and .16 or .08) then
        local elapsed=nextSample.time-prior.time
        local p,q=prior.point,target.world
