function R.flush()
    if not R.active then return end
    -- Re-check focus and live state immediately before native input.
    local good,focused=pcall(isrbxactive)
    local health=attribute(player,"Health")
    local fov=get(get(world,"CurrentCamera"),"FieldOfView")
    if not good or focused~=true or C.MenuOpen or not C.Enabled or R.button(2)~=true or attribute(player,"Dead")~=false or not finite(health) or health<=0 or attribute(player,"IsSpectating")==true or
        not R.prev or not same(get(player,"Character"),R.prev.char) or not same(get(world,"CurrentCamera"),R.prev.camera) or not finite(fov) or math.abs(fov-cfg.RCSFOV)>.25 then
        R.cancel("state changed before output"); return
    end
    local rx,ry=R.requestX or 0,R.requestY or 0
    local ax,ay=R.aimX,R.aimY
    local recoilLength=math.sqrt(rx*rx+ry*ry); local aimLength=math.sqrt(ax*ax+ay*ay)
    local aimBudget=math.max(0,12-recoilLength)
    if aimLength>aimBudget then
        local scale=aimBudget/aimLength
        ax=ax>=0 and math.floor(ax*scale) or math.ceil(ax*scale)
        ay=ay>=0 and math.floor(ay*scale) or math.ceil(ay*scale)
        R.aimClamps=R.aimClamps+1
    end
    local x,y=ax+rx,ay+ry
    if x~=0 or y~=0 then
        local ok,result=pcall(R.send,x,y)
        if not ok or result==false then
            R.failures=R.failures+1; R.fault="mouse output failed; rerun client"
            cfg.RCSEnabled=false; cfg.AimEnabled=false
            A.failures=A.failures+1; A.fault=R.fault; resetAim(R.fault); R.cancel(R.fault); event(R.fault..": "..str(result)); return
        end
        R.combinedCalls=R.combinedCalls+1; R.maxCombined=math.max(R.maxCombined,math.sqrt(x*x+y*y))
    end
    if rx~=0 or ry~=0 then R.correctionFrames=R.correctionFrames+1 end
    if cfg.RCSSustained then
        R.debtX=(R.debtX or 0)-rx;R.debtY=(R.debtY or 0)-ry
        R.sustainX=(R.sustainX or 0)+rx;R.sustainY=(R.sustainY or 0)+ry
        R.appliedX=0;R.appliedY=0
    else R.appliedX=R.appliedX+rx; R.appliedY=R.appliedY+ry end
end

