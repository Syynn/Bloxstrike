    local now=clock();local origin=xyz(get(camera,"Position"))
    if not origin or not p then W.status="unknown: camera/point unavailable";W.unknown=W.unknown+1;return false end
    local prior=W.cache[e.key]
    if not fresh and prior and now-prior.at<.04 then
        local o,q=prior.origin,prior.point
        if math.abs(o[1]-origin[1])+math.abs(o[2]-origin[2])+math.abs(o[3]-origin[3])<.2 and math.abs(q[1]-p[1])+math.abs(q[2]-p[2])+math.abs(q[3]-p[3])<.2 then W.status=prior.status;return prior.clear end
